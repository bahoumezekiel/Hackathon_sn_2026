# Le fichier .env est généré par « python scripts/init_env.py » (secrets aléatoires).
# Ne le versionnez jamais. Les réglages ci-dessous sont facultatifs : ajoutez-les au .env
# puis relancez « docker compose up -d --force-recreate gateway ».

# SMS : « simulateur » (aucun envoi réel, téléphone simulé sur :3002/telephone) ou « twilio »
FASOLINK_SMS_PROVIDER=simulateur

# Twilio (seulement si FASOLINK_SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Adresse publique où Twilio relaie les réponses des usagers (ex. https://xxxx.ngrok-free.app/sms/twilio)
TWILIO_WEBHOOK_URL=

# Accord par appel vocal (touches 1 / 2) et adresse publique de la passerelle, sans chemin
FASOLINK_VOICE_CONSENT=0
FASOLINK_PUBLIC_URL=

# Démonstration : vrai téléphone pour un IUE fictif (IUE=+226XXXXXXXX, séparés par des virgules)
FASOLINK_SMS_DEMO_PHONES=
