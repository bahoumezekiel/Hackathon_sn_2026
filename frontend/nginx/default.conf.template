server {
    listen 80;
    server_tokens off;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # La documentation de l'API reste sur la passerelle (port 8000), pas sur les portails
    location ~ ^/api/(docs|redoc|openapi\.json) {
        return 404;
    }

    # Passerelle FasoLink servie sur la même origine : ni CORS, ni cookie
    location /api/ {
        proxy_pass http://gateway:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        client_max_body_size 64k;
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # Fichiers versionnés par Vite (nom haché) : cache permanent
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # Application monopage : index.html toujours revalidé
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/conf.d/security-headers.inc;
    }
}
